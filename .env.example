# kubo-erp — variables de entorno

MIX_ENV=prod
PORT=8083

DATABASE_URL=ecto://kubo_erp:cambiar_password@localhost:5433/kubo_erp

# Bus de eventos. Si se deja vacio, el servicio opera sin publicar eventos.
AMQP_URL=amqp://kubo:cambiar_password@localhost:5673

# Secreto de firma (obligatorio en produccion). Generar con: mix phx.gen.secret
SECRET_KEY_BASE=cambiar_por_un_valor_aleatorio_de_64_caracteres

# Aplica migraciones al arrancar el contenedor
KUBO_RUN_MIGRATIONS=true

# Arranca el servidor HTTP (necesario con mix release)
PHX_SERVER=true
